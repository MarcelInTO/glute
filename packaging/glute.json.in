# Scoop manifest template for glute — the Windows counterpart of glute.rb.in.
#
# `make manifest` substitutes the @PLACEHOLDER@ tokens from dist/SHA256SUMS and
# writes dist/glute.json; the release workflow then commits that to
# bucket/glute.json in github.com/MarcelInTO/scoop-bucket. Same reasoning as the
# formula: a reviewable template in the repo, generatable locally before a tag is
# spent on it, rather than a heredoc inside CI.
#
# JSON has no comments, so `make manifest` drops everything above the opening
# brace. The "##" key is Scoop's own comment field and is how the provenance note
# reaches the published manifest.
#
# The release zip nests everything under glute-X.Y.Z-windows-amd64/, hence
# extract_dir: Scoop lifts that folder's contents into the app directory so `bin`
# can name glute.exe at the top. Only 64bit is offered because windows/amd64 is
# the only Windows row in the Makefile's PLATFORMS. checkver/autoupdate are not
# used by our release workflow (it pushes a complete manifest); they let Scoop's
# own `checkver -u` tooling bump the manifest from GitHub's releases/latest (which
# excludes prereleases) if that path is ever wanted, and they document the URL
# scheme. Scoop checks the sha256 on install.
{
  "##": [
    "Generated by glute's release workflow from packaging/glute.json.in.",
    "Source of truth: git@studio.wevr.com:wevr/tech/glute.git, mirrored to github.com/MarcelInTO/glute.",
    "Hand edits here are overwritten by the next release."
  ],
  "version": "@VERSION@",
  "description": "Terminal dashboard for GitLab CI/CD pipeline and job statistics",
  "homepage": "https://github.com/MarcelInTO/glute",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "@BASE@/glute-@VERSION@-windows-amd64.zip",
      "hash": "@SHA_WINDOWS_AMD64@",
      "extract_dir": "glute-@VERSION@-windows-amd64"
    }
  },
  "bin": "glute.exe",
  "notes": "Run 'glute auth' to connect to a GitLab instance, then 'glute' to open the dashboard.",
  "checkver": {
    "github": "https://github.com/MarcelInTO/glute"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/MarcelInTO/glute/releases/download/v$version/glute-$version-windows-amd64.zip",
        "extract_dir": "glute-$version-windows-amd64"
      }
    },
    "hash": {
      "url": "https://github.com/MarcelInTO/glute/releases/download/v$version/SHA256SUMS"
    }
  }
}
